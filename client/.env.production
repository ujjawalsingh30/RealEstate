# (for example: https://realestate-backend.onrender.com/api or https://realestate-api.vercel.app/api)
# OR add VITE_BACKEND_URL in your Vercel Dashboard -> Settings -> Environment Variables and redeploy!

VITE_BACKEND_URL=https://your-deployed-backend-url.onrender.com/api
VITE_API_URL=https://your-deployed-backend-url.onrender.com/api
VITE_CLOUDINARY_CLOUD_NAME=dsxgkzblp
